# ================================================
# BTC Guesser — Esempio Configurazione (.env.example)
# Copia questo file in .env e inserisci le tue credenziali
# ================================================

# Percentuale di core CPU da utilizzare di default all'avvio (1-100)
CPU_PERCENTAGE=25

# Delay tra gli spin in millisecondi (0 = massima velocità)
SPIN_DELAY_MS=0

# Porta web dashboard
WEB_PORT=3000

# Intervallo log su console (secondi)
STATS_LOG_INTERVAL_SEC=30

# Intervallo salvataggio statistiche su disco (secondi)
PERSIST_INTERVAL_SEC=60

# Notifiche Pushover (lascia vuoto per disabilitare)
PUSHOVER_USER_KEY=
PUSHOVER_API_TOKEN=

# Intervallo in giorni per l'invio del report di riepilogo/progresso su Pushover
PUSHOVER_REPORT_DAYS=3
